<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Steve: Minecraft Pocket Edition (native, GLES 1.1) -->
        <activity
            android:name="com.mojang.minecraftpe.MainActivity"
            android:label="@string/app_name_short"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTop">

            <meta-data
                android:name="android.app.lib_name"
                android:value="minecraftpe" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.mojang.minecraftpe.MainMenuOptionsActivity"
            android:exported="false" />

        <!-- Mario: Super Mario 64 PC port (libsm64.so, GLES 2.0) + touch controller -->
        <activity
            android:name="com.mojang.minecraftpe.sm64.Sm64Activity"
            android:label="Super Mario 64"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

    </application>

</manifest>
